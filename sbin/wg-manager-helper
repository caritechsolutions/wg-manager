#!/usr/bin/env php
<?php
/*
 * wg-manager-helper — the only program the web app may run as root (via sudo).
 *
 * It takes no free-form input from the web side except the state file, which
 * it fully re-validates before rendering anything. Subcommands:
 *
 *   apply                     render /etc/wireguard/<if>.conf and bring the hub in line
 *   status                    live peer stats (JSON, no private/preshared keys)
 *   health                    service / routing / firewall / TLS checks (JSON)
 *   server-key generate [--force] | set (key on stdin) | public
 *   hook-up <if> | hook-down <if>   called by wg-quick PostUp/PostDown
 *
 * Output is always one JSON object: {"ok":true,...} or {"ok":false,"error":...}
 */
declare(strict_types=1);

$testMode = getenv('WGM_HELPER_TEST') === '1' && function_exists('posix_geteuid') && posix_geteuid() !== 0;
if (!$testMode) {
    define('WGM_IS_HELPER', true);
}
$lib = is_file(__DIR__ . '/../lib/bootstrap.php') && $testMode ? __DIR__ . '/../lib/bootstrap.php' : '/opt/wg-manager/lib/bootstrap.php';
require $lib;

umask(0077);

const KEY_FILE = WGM_KEY_DIR . '/server.key';
const ACTIVE_FILE = WGM_KEY_DIR . '/active-interface';
const SYSCTL_FILE = '/etc/sysctl.d/99-wg-manager.conf';
const LOCK_FILE = '/run/wg-manager-helper';
const GEN_MARK = '# Generated by wg-manager';

function out(array $data, int $code = 0): void
{
    echo json_encode($data, JSON_UNESCAPED_SLASHES) . "\n";
    exit($code);
}

function fail(string $msg): void
{
    out(['ok' => false, 'error' => $msg], 1);
}

/** Run a command without a shell. @return array{0:int,1:string,2:string} */
function run(array $cmd, string $stdin = ''): array
{
    $p = @proc_open($cmd, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
    if (!is_resource($p)) {
        return [127, '', 'cannot execute ' . $cmd[0]];
    }
    fwrite($pipes[0], $stdin);
    fclose($pipes[0]);
    $o = (string)stream_get_contents($pipes[1]);
    $e = (string)stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    return [proc_close($p), $o, $e];
}

function must(array $cmd, string $stdin = ''): string
{
    [$c, $o, $e] = run($cmd, $stdin);
    if ($c !== 0) {
        throw new RuntimeException(implode(' ', $cmd) . ': ' . trim($e ?: $o));
    }
    return $o;
}

function loadState(): array
{
    $state = Store::load();
    $errors = State::validate($state);
    if ($errors) {
        throw new RuntimeException('State is invalid: ' . implode(' ', $errors));
    }
    return $state;
}

function readKey(): ?string
{
    if (!is_file(KEY_FILE)) {
        return null;
    }
    $k = trim((string)file_get_contents(KEY_FILE));
    return Keys::isKey($k) ? $k : null;
}

function writeKey(string $k): void
{
    if (!is_dir(WGM_KEY_DIR)) {
        mkdir(WGM_KEY_DIR, 0700, true);
    }
    chmod(WGM_KEY_DIR, 0700);
    Util::writeFile(KEY_FILE, $k . "\n", 0600);
}

function ifaceExists(string $if): bool
{
    return is_dir('/sys/class/net/' . $if);
}

function egressInterface(array $s): ?string
{
    if ($s['firewall']['natInterface'] !== '') {
        return $s['firewall']['natInterface'];
    }
    [$c, $o] = run(['ip', '-4', 'route', 'show', 'default']);
    if ($c === 0 && preg_match('/\bdev\s+(\S+)/', $o, $m) && preg_match(State::IFACE_RE, $m[1])) {
        return $m[1];
    }
    return null;
}

// ---------------------------------------------------------------------- routes

/** @return string[] CIDRs currently routed into $if by us */
function currentRoutes(string $if): array
{
    if (!ifaceExists($if)) {
        return [];
    }
    [, $o] = run(['ip', '-4', '-o', 'route', 'show', 'dev', $if, 'proto', Render::ROUTE_PROTO]);
    $r = [];
    foreach (preg_split('/\n/', trim($o)) ?: [] as $line) {
        $t = strtok(trim($line), ' ');
        if ($t && ($p = Ip::parseCidr($t))) {
            $r[] = $p['text'];
        }
    }
    sort($r);
    return $r;
}

/** @return array{added:string[],removed:string[]} */
function syncRoutes(array $state, string $if): array
{
    $want = array_keys(Render::routes($state));
    $have = currentRoutes($if);
    $added = $removed = [];
    foreach (array_diff($have, $want) as $r) {
        run(['ip', '-4', 'route', 'del', $r, 'dev', $if, 'proto', Render::ROUTE_PROTO]);
        $removed[] = $r;
    }
    foreach ($want as $r) {
        must(['ip', '-4', 'route', 'replace', $r, 'dev', $if, 'proto', Render::ROUTE_PROTO]);
        if (!in_array($r, $have, true)) {
            $added[] = $r;
        }
    }
    return ['added' => array_values($added), 'removed' => array_values($removed)];
}

// ---------------------------------------------------------------------- firewall

function ipt(array $args, string $table = 'filter'): array
{
    return run(array_merge(['iptables', '-w', '-t', $table], $args));
}

function ensureChain(string $chain, string $parent, string $table, bool $first = true): void
{
    ipt(['-N', $chain], $table);         // fails harmlessly if it exists
    ipt(['-F', $chain], $table);
    [$c] = ipt(['-C', $parent, '-j', $chain], $table);
    if ($c !== 0) {
        ipt($first ? ['-I', $parent, '1', '-j', $chain] : ['-A', $parent, '-j', $chain], $table);
    }
}

function dropChain(string $chain, string $parent, string $table): void
{
    for ($i = 0; $i < 5; $i++) {
        [$c] = ipt(['-D', $parent, '-j', $chain], $table);
        if ($c !== 0) {
            break;
        }
    }
    ipt(['-F', $chain], $table);
    ipt(['-X', $chain], $table);
}

function firewallUp(array $state, string $if): array
{
    $s = $state['settings'];
    $fw = $s['firewall'];
    $net = Ip::ifaceV4($s['address'])['cidr'];
    $rules = [];

    ensureChain('WGM-IN', 'INPUT', 'filter');
    $rules[] = ['filter', ['-A', 'WGM-IN', '-p', 'udp', '--dport', (string)$s['listenPort'], '-j', 'ACCEPT']];

    ensureChain('WGM-FWD', 'FORWARD', 'filter');
    $rules[] = ['filter', ['-A', 'WGM-FWD', '-m', 'conntrack', '--ctstate', 'RELATED,ESTABLISHED', '-j', 'ACCEPT']];
    if (!$fw['peerToPeer']) {
        $rules[] = ['filter', ['-A', 'WGM-FWD', '-i', $if, '-o', $if, '-j', 'DROP']];
    }
    if ($fw['enforceAllowedIps']) {
        foreach (Render::activeClients($state) as $c) {
            $dsts = array_values(array_filter(State::clientAllowedIps($state, $c), fn($x) => (Ip::parseCidr($x)['family'] ?? 0) === 4));
            foreach (array_merge([$c['address'] . '/32'], $c['serverRoutes']) as $src) {
                foreach ($dsts as $dst) {
                    $rules[] = ['filter', ['-A', 'WGM-FWD', '-i', $if, '-s', $src, '-d', Ip::parseCidr($dst)['text'], '-j', 'ACCEPT']];
                }
            }
        }
        $rules[] = ['filter', ['-A', 'WGM-FWD', '-i', $if, '-j', 'DROP']];
    } else {
        $rules[] = ['filter', ['-A', 'WGM-FWD', '-i', $if, '-j', 'ACCEPT']];
    }
    $rules[] = ['filter', ['-A', 'WGM-FWD', '-o', $if, '-j', 'ACCEPT']];

    ensureChain('WGM-NAT', 'POSTROUTING', 'nat');
    $egress = null;
    if ($fw['nat']) {
        $egress = egressInterface($s);
        $rules[] = ['nat', $egress
            ? ['-A', 'WGM-NAT', '-s', $net, '-o', $egress, '-j', 'MASQUERADE']
            : ['-A', 'WGM-NAT', '-s', $net, '!', '-o', $if, '-j', 'MASQUERADE']];
    }

    $errors = [];
    foreach ($rules as [$table, $args]) {
        [$c, , $e] = ipt($args, $table);
        if ($c !== 0) {
            $errors[] = trim($e);
        }
    }
    if ($errors) {
        throw new RuntimeException('iptables: ' . implode('; ', array_unique($errors)));
    }
    return ['rules' => count($rules), 'natEgress' => $egress];
}

function firewallDown(): void
{
    dropChain('WGM-IN', 'INPUT', 'filter');
    dropChain('WGM-FWD', 'FORWARD', 'filter');
    dropChain('WGM-NAT', 'POSTROUTING', 'nat');
}

function applySysctl(array $state): void
{
    if ($state['settings']['firewall']['ipForward']) {
        Util::writeFile(SYSCTL_FILE, "# wg-manager\nnet.ipv4.ip_forward = 1\n", 0644);
        run(['sysctl', '-q', '-w', 'net.ipv4.ip_forward=1']);
    } elseif (is_file(SYSCTL_FILE)) {
        unlink(SYSCTL_FILE);   // leave the running value alone (Docker etc. may need it)
    }
}

// ---------------------------------------------------------------------- commands

function interfaceSection(string $conf): string
{
    $out = [];
    foreach (explode("\n", $conf) as $l) {
        if (trim($l) === '[Peer]') {
            break;
        }
        if (preg_match('/^\s*(Address|MTU|Table|PostUp|PostDown|PreUp|PreDown|DNS|SaveConfig)\s*=/i', $l)) {
            $out[] = trim($l);
        }
    }
    return implode("\n", $out);
}

function cmdApply(): void
{
    $state = loadState();
    $s = $state['settings'];
    $if = $s['interface'];
    $key = readKey();
    if ($key === null) {
        fail('The server private key is missing (' . KEY_FILE . '). Run: wgm init  (or import a wg-easy backup).');
    }
    if (Keys::publicFromPrivate($key) !== $state['server']['publicKey']) {
        fail('The server public key in the state does not match the private key on disk. Run: wgm repair-key');
    }

    $lock = fopen(LOCK_FILE . '.lock', 'c');
    flock($lock, LOCK_EX);

    $prev = is_file(ACTIVE_FILE) ? trim((string)file_get_contents(ACTIVE_FILE)) : '';
    $confPath = WGM_WG_DIR . '/' . $if . '.conf';
    $full = Render::server($state, $key, true);
    $stripped = Render::server($state, $key, false);

    if (is_file($confPath) && strpos((string)file_get_contents($confPath), GEN_MARK) !== 0) {
        fail("$confPath exists and was not written by wg-manager. Move it away first (it would be overwritten).");
    }

    applySysctl($state);

    $actions = [];
    if ($prev !== '' && $prev !== $if && preg_match(State::IFACE_RE, $prev)) {
        run(['systemctl', 'disable', '--now', 'wg-quick@' . $prev]);
        $old = WGM_WG_DIR . '/' . $prev . '.conf';
        if (is_file($old) && strpos((string)file_get_contents($old), GEN_MARK) === 0) {
            unlink($old);
        }
        $actions[] = "stopped $prev";
    }

    $oldConf = is_file($confPath) ? (string)file_get_contents($confPath) : '';
    $needRestart = !ifaceExists($if) || interfaceSection($oldConf) !== interfaceSection($full);
    if (!is_dir(WGM_WG_DIR)) {
        mkdir(WGM_WG_DIR, 0700, true);
    }
    Util::writeFile($confPath, $full, 0600);

    $routes = ['added' => [], 'removed' => []];
    $fw = null;
    if ($needRestart) {
        run(['systemctl', 'enable', 'wg-quick@' . $if]);
        [$c, $o, $e] = run(['systemctl', 'restart', 'wg-quick@' . $if]);
        if ($c !== 0) {
            [, $log] = run(['journalctl', '-u', 'wg-quick@' . $if, '-n', '15', '--no-pager', '-o', 'cat']);
            fail("Starting wg-quick@$if failed: " . trim($e ?: $o) . "\n" . trim($log));
        }
        $actions[] = ifaceExists($if) && $oldConf !== '' ? "restarted $if" : "started $if";
        $routes['added'] = currentRoutes($if);
    } else {
        $tmp = tempnam('/run', 'wgm');
        file_put_contents($tmp, $stripped);
        chmod($tmp, 0600);
        try {
            must(['wg', 'syncconf', $if, $tmp]);
        } finally {
            unlink($tmp);
        }
        $actions[] = "synced $if";
        $routes = syncRoutes($state, $if);
        $fw = firewallUp($state, $if);
    }
    Util::writeFile(ACTIVE_FILE, $if . "\n", 0600);
    flock($lock, LOCK_UN);

    out(['ok' => true, 'interface' => $if, 'actions' => $actions, 'routes' => $routes,
         'peers' => count(Render::activeClients($state)), 'firewall' => $fw]);
}

function cmdStatus(): void
{
    $state = loadState();
    $if = $state['settings']['interface'];
    $active = is_file(ACTIVE_FILE) ? trim((string)file_get_contents(ACTIVE_FILE)) : '';
    $key = readKey();
    $confPath = WGM_WG_DIR . '/' . $if . '.conf';
    $inSync = $key !== null && is_file($confPath) && file_get_contents($confPath) === Render::server($state, $key, true)
        && ifaceExists($if) && currentRoutes($if) === array_keys(Render::routes($state));

    $res = ['ok' => true, 'interface' => $if, 'activeInterface' => $active, 'up' => ifaceExists($if),
            'inSync' => $inSync, 'time' => time(), 'peers' => (object)[]];
    if (!$res['up']) {
        out($res);
    }
    [$c, $o, $e] = run(['wg', 'show', $if, 'dump']);
    if ($c !== 0) {
        fail('wg show failed: ' . trim($e));
    }
    $lines = explode("\n", trim($o));
    $first = explode("\t", array_shift($lines));
    $res['listenPort'] = (int)($first[2] ?? 0);
    $res['publicKey'] = $first[1] ?? '';
    $peers = [];
    foreach ($lines as $l) {
        $f = explode("\t", $l);
        if (count($f) < 8) {
            continue;
        }
        // public, preshared(ignored), endpoint, allowed-ips, handshake, rx, tx, keepalive
        $peers[$f[0]] = [
            'endpoint'   => $f[2] === '(none)' ? '' : $f[2],
            'allowedIps' => $f[3] === '(none)' ? '' : $f[3],
            'handshake'  => (int)$f[4],
            'rx'         => (int)$f[5],
            'tx'         => (int)$f[6],
        ];
    }
    $res['peers'] = (object)$peers;
    out($res);
}

function cmdHealth(): void
{
    $state = loadState();
    $s = $state['settings'];
    $if = $s['interface'];
    $checks = [];
    $add = function (string $name, bool $ok, string $detail) use (&$checks) {
        $checks[] = ['name' => $name, 'ok' => $ok, 'detail' => $detail];
    };

    [, $a] = run(['systemctl', 'is-active', 'wg-quick@' . $if]);
    [, $en] = run(['systemctl', 'is-enabled', 'wg-quick@' . $if]);
    $add("wg-quick@$if", trim($a) === 'active', trim($a) . ', ' . trim($en));

    $fwd = trim((string)@file_get_contents('/proc/sys/net/ipv4/ip_forward'));
    $add('ip_forward', !$s['firewall']['ipForward'] || $fwd === '1', $fwd === '1' ? 'enabled' : 'disabled');

    $want = array_keys(Render::routes($state));
    $have = currentRoutes($if);
    $missing = array_diff($want, $have);
    $add('Routes vs config', !$missing && count($want) === count($have), count($have) . ' / ' . count($want) . ' present' . ($missing ? ' — missing ' . implode(', ', $missing) : ''));

    [$c] = ipt(['-C', 'FORWARD', '-j', 'WGM-FWD']);
    $add('Firewall rules', $c === 0, $c === 0 ? 'loaded' : 'not loaded');

    $key = readKey();
    $add('Server key', $key !== null && Keys::publicFromPrivate($key) === $state['server']['publicKey'], $key === null ? 'missing' : 'present');

    [, $ng] = run(['systemctl', 'is-active', 'nginx']);
    $add('nginx', trim($ng) === 'active', trim($ng));

    [, $units] = run(['systemctl', 'list-units', '--type=service', '--no-legend', '--plain', 'php*-fpm.service']);
    $fpm = preg_match('/^(php\S*-fpm)\.service\s+\S+\s+(\S+)\s+(\S+)/m', $units, $m) ? $m : null;
    $add('php-fpm', $fpm !== null && $fpm[3] === 'running', $fpm ? $fpm[1] . ' ' . $fpm[3] : 'not found');

    [, $t] = run(['systemctl', 'is-active', 'wg-manager-tick.timer']);
    $add('Background timer', trim($t) === 'active', trim($t));

    $install = Util::readJson(WGM_INSTALL_FILE, []) ?? [];
    $domain = (string)($install['domain'] ?? '');
    if ($domain !== '' && preg_match('/^[A-Za-z0-9.-]+$/', $domain)) {
        $cert = '/etc/letsencrypt/live/' . $domain . '/cert.pem';
        if (is_file($cert)) {
            $x = openssl_x509_parse((string)file_get_contents($cert));
            $days = $x ? (int)floor(($x['validTo_time_t'] - time()) / 86400) : -1;
            $add('TLS certificate', $days > 14, $days >= 0 ? "expires in $days days" : 'unreadable');
        } else {
            $add('TLS certificate', false, 'not found for ' . $domain);
        }
    } else {
        $add('TLS certificate', true, 'not configured (plain HTTP)');
    }

    $free = @disk_free_space(WGM_STATE_DIR);
    $add('Disk space', $free === false || $free > 100 * 1024 * 1024, $free === false ? 'unknown' : Util::bytes($free) . ' free');

    out(['ok' => true, 'version' => WGM_VERSION, 'checks' => $checks]);
}

function cmdServerKey(array $argv): void
{
    $sub = $argv[2] ?? '';
    if ($sub === 'public') {
        $k = readKey();
        $k === null ? fail('No server key.') : out(['ok' => true, 'publicKey' => Keys::publicFromPrivate($k)]);
    }
    if ($sub === 'generate') {
        $k = readKey();
        if ($k !== null && ($argv[3] ?? '') !== '--force') {
            out(['ok' => true, 'publicKey' => Keys::publicFromPrivate($k), 'created' => false]);
        }
        $k = Keys::generatePrivate();
        writeKey($k);
        out(['ok' => true, 'publicKey' => Keys::publicFromPrivate($k), 'created' => true]);
    }
    if ($sub === 'set') {
        $k = trim((string)stream_get_contents(STDIN));
        if (!Keys::isKey($k)) {
            fail('Not a valid WireGuard private key.');
        }
        writeKey($k);
        out(['ok' => true, 'publicKey' => Keys::publicFromPrivate($k), 'created' => true]);
    }
    fail('usage: server-key generate [--force] | set | public');
}

/** wg-quick hooks must never fail, or the interface is torn down. */
function cmdHook(string $which, string $if): void
{
    try {
        if (!preg_match(State::IFACE_RE, $if)) {
            throw new RuntimeException('bad interface');
        }
        $state = loadState();
        if ($state['settings']['interface'] !== $if) {
            throw new RuntimeException("$if is not the managed interface");
        }
        if ($which === 'up') {
            syncRoutes($state, $if);
            firewallUp($state, $if);
        } else {
            firewallDown();
        }
        out(['ok' => true]);
    } catch (Throwable $e) {
        fwrite(STDERR, 'wg-manager hook-' . $which . ': ' . $e->getMessage() . "\n");
        out(['ok' => false, 'error' => $e->getMessage()], 0);
    }
}

// ---------------------------------------------------------------------- main

try {
    if (!$testMode && !Util::isRoot()) {
        fail('wg-manager-helper must run as root.');
    }
    $cmd = $argv[1] ?? '';
    switch ($cmd) {
        case 'apply':
            cmdApply();
            break;
        case 'status':
            cmdStatus();
            break;
        case 'health':
            cmdHealth();
            break;
        case 'server-key':
            cmdServerKey($argv);
            break;
        case 'hook-up':
            cmdHook('up', (string)($argv[2] ?? ''));
            break;
        case 'hook-down':
            cmdHook('down', (string)($argv[2] ?? ''));
            break;
        default:
            fail('usage: wg-manager-helper apply|status|health|server-key|hook-up <if>|hook-down <if>');
    }
} catch (Throwable $e) {
    fail($e->getMessage());
}
